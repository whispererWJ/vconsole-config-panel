{
  "name": "@whisperer07/vconsole-config-panel",
  "version": "1.0.0",
  "description": "A configuration display panel plugin for vConsole",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "unpkg": "dist/index.js",
  "jsdelivr": "dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite serve --mode e2e",
    "build": "vite build --mode lib",
    "build:lib": "vite build --mode lib",
    "build:e2e": "vite build --mode e2e",
    "preview": "vite preview --mode e2e",
    "test": "vitest --config vitest.config.ts"
  },
  "keywords": [
    "vconsole",
    "plugin",
    "debug",
    "config-panel",
    "mobile-debug"
  ],
  "author": {
    "name": "whispererWJ",
    "email": "whisperer07@foxmail.com",
    "url": "https://github.com/whispererWJ"
  },
  "license": "MIT",
  "peerDependencies": {
    "vconsole": ">=3.0.0"
  },
  "devDependencies": {
    "@immense/vue-pom-generator": "^1.0.72",
    "@playwright/test": "^1.61.1",
    "@types/node": "^20.14.2",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "playwright": "^1.61.1",
    "prettier": "^3.3.2",
    "tslib": "^2.6.3",
    "typescript": "^5.5.2",
    "vconsole": "^3.15.1",
    "vite": "^5.3.1",
    "vite-plugin-dts": "^3.9.1",
    "vitest": "^4.1.10",
    "vue": "^3.4.27",
    "vue-router": "^4.3.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/whispererWJ/vconsole-config-panel.git"
  },
  "bugs": {
    "url": "https://github.com/whispererWJ/vconsole-config-panel/issues"
  },
  "homepage": "https://github.com/whispererWJ/vconsole-config-panel#readme",
  "engines": {
    "node": ">=16.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
